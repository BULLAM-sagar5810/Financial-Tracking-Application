{
  "info": {
    "name": "FinTrack API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "access",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/auth/register/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"Str0ng!Pass99\"\n}"
        }
      }
    },
    {
      "name": "Login (copy access token into {{access}})",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/auth/login/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"Str0ng!Pass99\"\n}"
        }
      }
    },
    {
      "name": "Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/auth/profile/"
      }
    },
    {
      "name": "Categories (expense)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/categories/?type=expense"
      }
    },
    {
      "name": "Add income",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/income/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": 1,\n  \"amount\": \"50000\",\n  \"date\": \"2026-11-01\",\n  \"description\": \"Salary\",\n  \"payment_method\": \"Bank Transfer\"\n}"
        }
      }
    },
    {
      "name": "Add expense",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/expenses/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": 6,\n  \"amount\": \"450.50\",\n  \"date\": \"2026-11-02\",\n  \"description\": \"Lunch\",\n  \"payment_method\": \"UPI\"\n}"
        }
      }
    },
    {
      "name": "List/filter transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/transactions/?type=expense&search=lunch&ordering=-amount"
      }
    },
    {
      "name": "Edit transaction",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/transactions/1/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": \"500\"\n}"
        }
      }
    },
    {
      "name": "Delete transaction",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/transactions/1/"
      }
    },
    {
      "name": "Create budget",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/budgets/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": 6,\n  \"month\": \"2026-11-01\",\n  \"amount\": \"5000\"\n}"
        }
      }
    },
    {
      "name": "List budgets",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/budgets/?month=2026-11"
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/dashboard/"
      }
    },
    {
      "name": "Monthly report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/reports/?period=monthly"
      }
    },
    {
      "name": "Export CSV",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/reports/export/"
      }
    },
    {
      "name": "Load demo data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{base}}/demo-data/"
      }
    }
  ]
}